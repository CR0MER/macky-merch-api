{
  "name": "lscs-merchapi",
  "version": "1.0.0",
  "main": "dist/server.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CR0MER/macky-merch-api.git"
  },
  "keywords": ["merch", "inventory", "rest-api", "express", "prisma", "mysql"],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/CR0MER/macky-merch-api/issues"
  },
  "homepage": "https://github.com/CR0MER/macky-merch-api#readme",
  "description": "A RESTful inventory management API for LSCS's official merchandise, built with Node.js, Express, TypeScript, Prisma, and MySQL.",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "prisma": "^6.19.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
